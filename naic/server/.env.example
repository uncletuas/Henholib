# Copy to .env and fill in. Never commit the real .env.

# --- N-ATLaS (the mandatory LLM integration) ---------------------------------
# Point this at the OpenAI-compatible endpoint serving NCAIR1/N-ATLaS:
#   - vLLM on the EC2 g5 box:   http://127.0.0.1:8000/v1
#   - HF Inference Endpoint:    https://<id>.endpoints.huggingface.cloud/v1
NATLAS_BASE_URL=
NATLAS_API_KEY=not-needed
NATLAS_MODEL=NCAIR1/N-ATLaS
# Set to 1 to run without a model (visible stub) while GPU capacity is pending.
NATLAS_STUB=1

# --- Hugging Face (pull the gated NCAIR weights: LLM + ASR) -------------------
# Accept terms on each model page first, then a read token:
#   huggingface.co/NCAIR1/N-ATLaS  + the four ASR repos
HF_TOKEN=

# --- ASR (NCAIR Nigerian speech models) --------------------------------------
ASR_DEVICE=cpu          # "cuda:0" to share the GPU; "cpu" is fine for Whisper-small
ASR_STUB=1              # 1 until torch + weights are installed

# --- WhatsApp (Twilio sandbox for the sprint) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Validation evidence ------------------------------------------------------
NAIC_DATA_DIR=./data
