{
  "name": "loopital-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for the Loopital marketing site and auth API.",
  "scripts": {
    "bootstrap": "cdk bootstrap",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never --outputs-file outputs.json",
    "destroy": "cdk destroy --force",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed-academy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.700.0",
    "aws-cdk-lib": "^2.173.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.173.0"
  }
}
