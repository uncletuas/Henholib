# Copy to .env, fill in, and start with:  uvicorn main:app --env-file .env --port 7860
# Never commit the real .env. The Colab notebook sets all of this for you.

# --- N-ATLaS (understanding and answering) -----------------------------------
# "local" loads NCAIR1/N-ATLaS into this process in 4-bit (one GPU, ~6 GB).
# "http" calls an OpenAI-compatible server instead, e.g. vLLM: http://127.0.0.1:8000/v1
NATLAS_BACKEND=local
NATLAS_BASE_URL=
NATLAS_API_KEY=not-needed
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_MAX_NEW_TOKENS=320
# 1 runs without a model (a visible stub), for trying the routes on a laptop.
NATLAS_STUB=0

# --- Hugging Face (pulls NCAIR's gated weights: N-ATLaS + ASR) ---------------
# Accept the licence on huggingface.co/NCAIR1/N-ATLaS and the four ASR repos first.
HF_TOKEN=

# --- Listening: NCAIR ASR, one model per language ----------------------------
ASR_DEVICE=cuda:0       # or "cpu"; Whisper-small runs acceptably on CPU
ASR_STUB=0

# --- Speaking: YarnGPT2b Nigerian voice (NCAIR publishes no TTS) -------------
TTS_ENABLED=1
TTS_STUB=0
TTS_MAX_WORDS=70
YARNGPT_DIR=./vendor                 # contains a clone of github.com/saheedniyi02/yarngpt
WAVTOKENIZER_CONFIG=./vendor/wavtokenizer/wavtokenizer_mediumdata_frame75_3s_nq1_code4096_dim512_kmeans200_attn.yaml
WAVTOKENIZER_CKPT=./vendor/wavtokenizer/wavtokenizer_large_speech_320_24k.ckpt

# --- Access ------------------------------------------------------------------
# Shared key for /v1, /asr and /tts. Leave empty only on a private machine.
NAIC_API_KEY=
# 1 loads every model at start-up so the first caller does not wait.
NAIC_PRELOAD=1

# --- WhatsApp (Twilio) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Validation evidence -----------------------------------------------------
NAIC_DATA_DIR=./naic-data
